                        "text": "var q=Math.max(0,Math.min(1,(time-0.05)/0.3875));var d=Math.pow(1-q,4);var f=Math.max(0,Math.min(1,(time-.48)/4.3));var h=f*f*(3-2*f);var s=100*(1-(1-0.95)*d+.018*h);[s,s,100]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
                      "hold_only": false,
